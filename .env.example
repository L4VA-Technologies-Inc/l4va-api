DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
NODE_ENV=
ENV_FILE=  # optional, dotenv file path (default .env)
GCP_SECRET_NAME=  # optional, Secret Manager secret to load (default: mainnet|testnet by NODE_ENV)
ENV_CHECK_DISABLED=false  # true skips the startup env check
ENV_CHECK_STRICT=false  # true aborts startup on env-check errors

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
SCANNER_URL=
SCANNER_KEY=

JWT_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_URL=
AWS_BUCKET_NAME=

BLOCKFROST_API_KEY=
BLOCKFROST_API_KEY_MAINNET=  # mainnet Blockfrost key (env check verifies it is a mainnet key)
BLOCKFROST_WEBHOOK_AUTH_TOKEN=

DEXHUNTER_API_KEY=
DEXHUNTER_BASE_URL=

NEXUS_API_KEY=
NEXUS_API_URL=https://nexus.gerowallet.io

TAPTOOLS_API_KEY=

CHARLI3_API_KEY=
CHARLI3_API_URL=https://api.charli3.io/api/v1

ANVIL_API_KEY=
ANVIL_API_URL=https://prod.api.ada-anvil.app/v2/services

NOVU_API_KEY=

STREAM_API_KEY=
STREAM_API_SECRET=

SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# In-app support chat ↔ Discord ticket channels (bot needs the Message Content intent).
# Each environment uses its own category; the same bot can serve several environments.
DISCORD_SUPPORT_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SUPPORT_CATEGORY_ID=
# Role that sees the ticket channels and gets pinged on new tickets
DISCORD_SUPPORT_ROLE_ID=
# Set to false on dev/staging so test tickets don't ping the role
DISCORD_SUPPORT_PING_ROLE=true

# On-chain configuration
SC_POLICY_ID=
CONTRIBUTION_SCRIPT_HASH=
DISPATCH_SCRIPT_HASH=
BLUEPRINT_TITLE=
VAULT_SCRIPT_ADDRESS=

VLRM_POLICY_ID=
VLRM_HEX_ASSET_NAME=

# GitHub configuration for metadata registry updates
GITHUB_TOKEN=
METADATA_API_URL=
METADATA_REGISTRY_OWNER=
METADATA_REGISTRY_REPO=

# Google Cloud configuration for treasury wallet and KMS functionality  
GCP_PROJECT_ID=  
GCP_KMS_LOCATION=  
GCP_KMS_KEYRING=  
GCP_KMS_KEY=  
GCP_AUDIT_BUCKET=  
GOOGLE_APPLICATION_CREDENTIALS=  

# L4VA Rewards Configuration
L4VA_POLICY_ID=ecfffe08c1735c9305957ed447375d18ab2e322c5d4e5e69aea335c0
L4VA_ASSET_NAME=4c34564154455354
L4VA_DECIMALS=6
L4VA_TREASURY_KEY=
L4VA_TREASURY_ADDRESS=
L4VA_TREASURY_KEY_HASH=

# Cardano L4VA buyback (cardano-buyback module). Always on once the wallets below are set. Dedicated wallet; fund it via POST /cardano-buyback/fund.
CARDANO_BUYBACK_CRON=                    # default every 6 hours
CARDANO_BUYBACK_L4VA_POLICY_ID=          # own var on purpose; mainnet must be a deployed policy (ac1e9156…)
CARDANO_BUYBACK_L4VA_ASSET_NAME=
CARDANO_BUYBACK_L4VA_DECIMALS=           # required, no default
CARDANO_BUYBACK_ADDRESS=
CARDANO_BUYBACK_S_KEY=                   # bech32 ed25519 payment key of CARDANO_BUYBACK_ADDRESS
CARDANO_BUYBACK_OPS_ADDRESS=
CARDANO_BUYBACK_TREASURY_ADDRESS=        # default L4VA_TREASURY_ADDRESS
CARDANO_BUYBACK_BURN_ADDRESS=            # testnet only, for a non-deployed L4VA policy; mainnet always burns on-chain
CARDANO_BUYBACK_BURN_BPS=2500
CARDANO_BUYBACK_TREASURY_BPS=2500        # ops gets the remainder
CARDANO_BUYBACK_RESERVE_LOVELACE=10000000
CARDANO_BUYBACK_MIN_SWAP_LOVELACE=50000000
CARDANO_BUYBACK_MAX_SWAP_LOVELACE=1000000000
CARDANO_BUYBACK_SLIPPAGE_PCT=1
CARDANO_BUYBACK_MAX_PRICE_IMPACT_BPS=300
CARDANO_BUYBACK_MIN_L4VA_PER_ADA=0       # price floor, L4VA base units per 1 ADA; 0 disables (required > 0 on mainnet)
CARDANO_BUYBACK_MIN_DISTRIBUTE=          # L4VA base units; default 1 L4VA

# ETH (ROBINHOOD) CONFIGURATION
EVM_FACTORY_ADDRESS=
EVM_RPC_URL=
# Optional comma-separated backup read RPCs (writes always use EVM_RPC_URL only).
# Alchemy for EVM_CHAIN_ID is added when ALCHEMY_API_KEY is set; public RPCs last unless EVM_RPC_PUBLIC_FALLBACKS=false.
EVM_RPC_FALLBACK_URLS=
EVM_RPC_PUBLIC_FALLBACKS=true
ROBINHOOD_RPC_URL=  # Robinhood RPC used by governance snapshots
ROBINHOOD_ALCHEMY_RPC_URL=  # optional, explicit Alchemy RPC (otherwise built from ALCHEMY_API_KEY)
EVM_CHAIN_ID=
EVM_ADMIN_ADDRESS=
# Slack alert when the admin wallet balance drops below this (wei); 0/unset = off
EVM_ADMIN_MIN_GAS_WEI=
# The admin (vault authority + creation approver) and minting keys live in Cloud KMS, never in env.
# Full key-version names: projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>/cryptoKeyVersions/<n>
# Each must resolve to the address above it; the VM service account needs roles/cloudkms.signerVerifier on it.
EVM_ADMIN_KMS_KEY=
EVM_MINTING_SIGNER_ADDRESS=
EVM_MINTING_SIGNER_KMS_KEY=
EVM_TREASURY_ADDRESS=
# Recipient of EVM governance fees (proposal creation + voting).
# Optional — falls back to EVM_TREASURY_ADDRESS when unset.
EVM_GOVERNANCE_FEE_ADDRESS=
EVM_CYCLE_AUTOMATION_ENABLED=
EVM_BACKFILL_LOOKBACK_BLOCKS=
EVM_BACKFILL_MAX_RANGE=
# First block the vault event indexer scans on a cold start (no Redis cursor). Set to the factory deploy block.
EVM_FACTORY_DEPLOY_BLOCK=
EVM_BATCH_DEPLOYER_ADDRESS=  # chunked vault deployer
EVM_ADAPTER_REGISTRY_ADDRESS=  # optional
EVM_MOCK_ADAPTER_ADDRESS=  # optional, testnet mock governance adapter
EVM_NFT_SALE_ADAPTER_ADDRESS=  # optional
EVM_DISTRIBUTION_AUTO_CLAIM=true  # false/0 disables auto-claim of EVM distributions
# Uniswap contract overrides. Unset = Robinhood mainnet defaults (testnet has none, set them there)
EVM_WETH_ADDRESS=
EVM_UNISWAP_V4_POOL_MANAGER=
EVM_UNISWAP_V4_QUOTER=
EVM_UNISWAP_V4_STATE_VIEW=
EVM_UNISWAP_V3_QUOTER=
# Vault LP (Uniswap v4); off unless EVM_LP_ENABLED=true
EVM_LP_ENABLED=false
EVM_LP_ADAPTER_ADDRESS=
EVM_LP_MIN_USD=0
EVM_LP_MAX_PRICE_DEVIATION_BPS=30
EVM_LP_V4_FEE=10000
EVM_LP_V4_TICK_SPACING=200
# Set to false to stop indexing vault events sent outside the app.
EVM_VAULT_EVENT_INDEXER_ENABLED=
ROBINHOOD_HOLDERS_API_BASE_URL=

EVM_SNAPSHOT_MAX_FULL_REPLAY_CHUNKS=400

# L4VABurnLock keeper — checks every 2 hours, calls burn() once per day (1M L4VA/day).
# Use a dedicated low-balance wallet; it can only trigger the burn. Uses EVM_RPC_URL / EVM_CHAIN_ID.
BURN_LOCK_ENABLED=false
BURN_LOCK_ADDRESS=
BURN_LOCK_KEEPER_PRIVATE_KEY=

ALCHEMY_API_KEY=
# Blockscout PRO API key (api.blockscout.com) for the holders API (EVM governance snapshots).
BLOCKSCOUT_API_KEY=
ALCHEMY_NETWORK=robinhood-testnet    # or robinhood-mainnet
ALCHEMY_WEBHOOK_SIGNING_KEY=

#Other envs
APP_HOST=
PORT=3000

# Cardano network selection (mainnet gates hidden-vault filtering across the app)
CARDANO_NETWORK=
NETWORK=mainnet
NETWORK_ID=

# On-chain admin / smart-contract signing
ADMIN_ADDRESS=
ADMIN_KEY_HASH=
ADMIN_S_KEY=
ADMIN_SERVICE_TOKEN=
CONTRACT_ADDRESS=
POOL_ADDRESS=
SC_VERSION=1.0.0
REFERENCE_SCRIPT_INDEX=0
REFERENCE_SCRIPT_TX_HASH=

# Redis (BullMQ / caching)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=0
BULL_REDIS_PORT=6379  # BullMQ port; kept separate because REDIS_PORT may be a host-mapped port
CLIENT_APP_URL=  # optional, frontend base URL for email/notification links (e.g. http://localhost:5173)

# Price feeds
COINGECKO_API_KEY=
COINGECKO_API_URL=
DEXSCREENER_CHAIN_ID=robinhood
PRICE_DEVIATION_PROTECTION_ENABLED=

# IPFS / NFT metadata
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Google Cloud Storage bucket (separate from GCP KMS/treasury config above)
GOOGLE_BUCKET_NAME=
GOOGLE_BUCKET_CREDENTIALS=

# Sentry
SENTRY_DNS_KEY=

# l4va-rewards internal service (BFF proxy)
REWARDS_SERVICE_URL=
INTERNAL_SERVICE_TOKEN=
L4VA_MONTHLY_BUDGET=

# GitHub metadata registry
METADATA_REGISTRY_FOLDER=

# Staking
STAKING_APY_VLRM=8
STAKING_APY_L4VA=5

# Cron schedules (override default CronExpression when set)
TOKEN_VERIFICATION_REFRESH_CRON=
TREASURY_WALLET_CRON=
VAULT_TVL_UPDATE_BASE_MINUTES=30
VAULT_TVL_UPDATE_JITTER_MINUTES=5

# GetStream chat — production keys used by migration scripts only
STREAM_API_KEY_PROD=
STREAM_API_SECRET_PROD=
# Cardano L4VA holder burn script (src/scripts/burn-cardano-l4va.ts); prompted when unset. Never commit.
HOLDER_S_KEY=

UNISWAP_API_KEY=
UNISWAP_CHAIN_ID=  # optional, defaults to EVM_CHAIN_ID; if set must equal it
UNISWAP_INTEGRATOR_FEE_BIPS=  # optional, integrator fee in bps (needs UNISWAP_FEE_RECIPIENT)
UNISWAP_FEE_RECIPIENT=
EVM_SWAP_ADAPTER_ADDRESS=...     # UniversalRouterSwapAdapter ("swap" tag) — governance + index vault trades
EVM_SWAP_ADAPTER_KIND=universal_router  # testnet: testnet_fixed_rate
EVM_SWAP_ADAPTER_MULTI_PATH=false  # true when EVM_SWAP_ADAPTER_ADDRESS supports MULTI_PATH_EXACT_IN (versioned adapters: evm-protocol-versions.ts)
INDEX_ROUTE_PROBE_NATIVE_WEI=10000000000000000  # optional, buy size of the token route check (0.01 ETH)
INDEX_BASKET_ALLOWED_ASSETS=  # optional, comma-separated token addresses allowed in index baskets (empty = no allowlist)
INDEX_ROUTE_MAX_ROUND_TRIP_LOSS_BPS=300  # optional, buy-then-sell cost above which a token is too illiquid for a basket
EVM_SWAP_SLIPPAGE_BPS=50         # optional, default 0.5%
# AI vault creation assistant
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_MAX_OUTPUT_TOKENS=2000

# Frontend origins allowed to request an EVM sign-in (EIP-4361) message, comma-separated
SIWE_ALLOWED_ORIGINS=https://app.l4va.org,https://testnet.l4va.org,http://localhost:5173
