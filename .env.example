# ── L4VA presale (backs l4va-org's cached /presale/* endpoints) ───────────────
# The live presale: its state is served, and the landing page sends buys to it.
PRESALE_ADDRESS=
PRESALE_DEPLOY_BLOCK=
#
# Successor presale, for extending a sale past its window. L4VAPresale cannot be
# extended in place (setSaleEndsAt only moves the deadline forward, and
# setSaleDuration is frozen once the sale opened), so an extension means a second
# contract holding the remaining allocation.
#
# Set these and the service polls both: it keeps serving PRESALE_ADDRESS until
# that sale ENDs, then switches to the successor, and it scans both for
# `Purchased` events so the feed and its all-time totals stay continuous across
# the handover. The landing page follows the served address automatically, so no
# rebuild is needed at the moment of the switch.
#
# Leave BOTH empty when there is no successor — the service then behaves exactly
# as a single-contract poller.
PRESALE_NEXT_ADDRESS=
PRESALE_NEXT_DEPLOY_BLOCK=
#
# Presale RPC polling is OFF by default. Set to true to poll the presale contract.
# PRESALE_POLLING_ENABLED=false
#
# Optional: override the RPC used for presale polling. Falls back to
# ALCHEMY_API_KEY+ALCHEMY_NETWORK, then EVM_RPC_URL.
# PRESALE_ALCHEMY_RPC_URL=
# eth_getLogs needs a wide block range: never point this at an Alchemy free tier
# endpoint, which caps getLogs at 10 blocks.
# PRESALE_LOG_RPC_URL=
# PRESALE_LOG_CHUNK_BLOCKS=50000

# Staking
STAKING_APY_VLRM=8
STAKING_APY_L4VA=5
